@inject NavigationManager Urihelper

@* SEO Variables - Reusable across all meta tags *@
@{
    // SEO Variables: Single source of truth for title and description
    string SeoTitle = "JSON and XML to Diagram Visualizer - Interactive Syncfusion Blazor Showcase";
    string SeoDescription = "Interactive Syncfusion Blazor demo for visualizing JSON and XML data as diagrams with real-time parsing and rich data visualization.";
    string SiteUrl = Urihelper.Uri.TrimEnd('/');
    string ApplicationName = "JSON and XML to Diagram Visualizer";
    string Publisher = "Syncfusion";
    string Language = "English";
    string SocialImage = SiteUrl + "/diagram_component.svg";
}

@page "/"
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- HTML Title - Used in browser tab (Reusable Variable: SeoTitle) -->
    <title>@SeoTitle</title>
    
    <!-- Primary Meta Tags (Reusable Variables) -->
    <meta name="title" content="@SeoTitle" />
    <meta name="description" content="@SeoDescription" />
    <meta name="robots" content="index, follow" />
    <meta name="keywords" content="JSON visualizer, XML diagram, Blazor components, data visualization, Syncfusion, interactive diagrams, diagram parser" />
    <meta name="publisher" content="@Publisher" />
    <meta name="language" content="@Language" />
    
    <!-- Canonical URL -->
    <link href="https://showcase.syncfusion.com/jsonxml-diagram-visualizer/blazor/" rel="canonical" />
    
    <!-- Alternate Language Tags (Reusable Variable: SiteUrl) -->
    <link rel="alternate" hreflang="en-US" href="@SiteUrl" />
    <link rel="alternate" hreflang="x-default" href="@SiteUrl" />
    
    <!-- Open Graph Meta Tags (Reusable Variables: SeoTitle, SeoDescription, SiteUrl, ApplicationName, SocialImage) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@SeoTitle" />
    <meta property="og:description" content="@SeoDescription" />
    <meta property="og:url" content="@SiteUrl" />
    <meta property="og:site_name" content="@ApplicationName" />
    <meta property="og:image" content="@SocialImage" />
    <meta property="og:image:alt" content="@ApplicationName Logo" />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter Card Meta Tags (Reusable Variables: SeoTitle, SeoDescription, SocialImage, ApplicationName) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@SeoTitle" />
    <meta name="twitter:description" content="@SeoDescription" />
    <meta name="twitter:image" content="@SocialImage" />
    <meta name="twitter:image:alt" content="@ApplicationName" />
    <meta name="twitter:site" content="@@Syncfusion" />
    
    <!-- Schema.org Structured Data - SoftwareApplication (Reusable Variables: ApplicationName, SeoDescription, SiteUrl) -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org/",
      "@@type": "SoftwareApplication",
      "name": "@ApplicationName",
      "description": "@SeoDescription",
      "url": "@SiteUrl",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Web",
      "offers": {
        "@@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "author": {
        "@@type": "Organization",
        "name": "@Publisher",
        "url": "https://www.syncfusion.com"
      },
      "softwareVersion": "1.0.0",
      "datePublished": "2024-01-01",
      "inLanguage": "en-US",
      "browserRequirements": "Requires JavaScript enabled"
    }
    </script>
    
    <base href="/" />
    <!-- Google Tag Manager -->
    <!-- Load GTM-WXZ6DX9B immediately on page load  -->
    <script>
        (function (w, d, s, l, i) {
            w[l] = w[l] || []; w[l].push({
                'gtm.start':
                    new Date().getTime(), event: 'gtm.js'
            }); var f = d.getElementsByTagName(s)[0],
                j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : ''; j.async = true; j.src =
                    'https://www.googletagmanager.com/gtm.js?id=' + i + dl; f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', 'GTM-WXZ6DX9B');
    </script>
    <!-- Load GTM-W8WD8WN on user interaction -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const events = ["mousemove", "scroll", "keydown", "touchstart"];
            function loadGTM() {
                events.forEach(event => document.removeEventListener(event, loadGTM));
                (function (w, d, s, l, i) {
                    w[l] = w[l] || []; w[l].push({
                        'gtm.start':
                            new Date().getTime(), event: 'gtm.js'
                    }); var f = d.getElementsByTagName(s)[0],
                        j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : ''; j.async = true; j.src =
                            'https://www.googletagmanager.com/gtm.js?id=' + i + dl; f.parentNode.insertBefore(j, f);
                })(window, document, 'script', 'dataLayer', 'GTM-W8WD8WN');
            }
            events.forEach(event => document.addEventListener(event, loadGTM, { once: true }));
        });
    </script>
    <meta charset="UTF-8" />
    <title>
        Json And Xml To Diagram Visualizer  - Syncfusion Blazor Components Showcase App
    </title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <link rel="icon" type="image/x-icon" href="favicon.ico">
@{#if Release}
    <link href="_content/BlazorServerCommon_NET8/css/styles.min.css" rel="stylesheet" />
    <script src="_content/BlazorServerCommon_NET8/interop.min.js" async></script>
@{#else}
    <link href="_content/BlazorServerCommon_NET8/css/styles.css" rel="stylesheet" />
    <script src="_content/BlazorServerCommon_NET8/interop.js" async></script>
@{#endif}
    <script src="_content/Syncfusion.Blazor/scripts/syncfusion-blazor.min.js"></script>
    <!-- To include the need theme -->
    <link id="theme-link" href="https://cdn.syncfusion.com/blazor/30.1.38/styles/tailwind.css" rel="stylesheet" />
    <HeadOutlet @rendermode="@InteractiveServer" />
</head>

<body>
    <Routes @rendermode="@InteractiveServer" />
    <!-- Google Tag Manager (noscript) -->
    <!--Page Load-->
    <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WXZ6DX9B" height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!--Interaction-->
    <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W8WD8WN" height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
        </environment>
    </div>
    <script src="_content/BlazorMonaco/jsInterop.js"></script>
    <script src="_content/BlazorMonaco/lib/monaco-editor/min/vs/loader.js"></script>
    <script src="_content/BlazorMonaco/lib/monaco-editor/min/vs/editor/editor.main.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
